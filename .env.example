# Configuración del Entorno de GlowBeauty Pro

# Puerto en el que corre la aplicación en el VPS (por defecto 3000)
PORT=3000
NODE_ENV=production

# Clave secreta para firmar los tokens JWT del panel administrativo (¡cámbiala por una cadena aleatoria y segura!)
JWT_SECRET=super_secreto_para_firmar_tokens_glowbeauty_cambiar_en_vps_2026

# Ruta opcional de la base de datos SQLite (si se omite, se guarda en ./data/glowbeauty.sqlite)
# SQLITE_DB_PATH=/var/www/glowbeauty/data/glowbeauty.sqlite

# API Key de Gemini para el Asistente IA de WhatsApp (Opcional: si no se coloca, el sistema usa respuestas inteligentes automáticas sin romper nada)
GEMINI_API_KEY=
